# Copie ce fichier en .env.local et remplis ta vraie cle API.
# .env.local est dans .gitignore et ne sera jamais commit.
#
# Setup Resend :
#   1. Cree un compte sur https://resend.com (gratuit, 100 emails/jour)
#   2. Va dans API Keys -> Create API Key
#   3. Donne-lui un nom (ex: "photo-pwa") -> Create
#   4. Copie la cle qui commence par "re_" et colle-la ci-dessous
#
# Expediteur :
#   - En test : laisse "onboarding@resend.dev" (domaine de Resend, accepte tous les destinataires)
#   - En prod : tu peux verifier ton propre domaine sur Resend et utiliser un sender du type "moi@mondomaine.com"

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev
